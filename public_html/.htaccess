# Serenique Marketplace - Apache Configuration
# Works on both LOCAL (XAMPP) and ASTON SERVER

# Enable URL rewriting
RewriteEngine On

# Set base directory
# RewriteBase /

# Prevent directory listing
Options -Indexes

# Allow access to static files
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# Handle PHP files
AddType application/x-httpd-php .php

# Protect sensitive files
<FilesMatch "^(config\.php|session\.php|\.htaccess)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow includes folder but protect PHP files from direct access
<Files "*.php">
    # Allow PHP files to be accessed
</Files>

# Custom error pages (optional)
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# PHP settings (if allowed by server)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 300
    php_value session.cookie_httponly 1
</IfModule>

